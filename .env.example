# Backend (abfall-api on Vercel)
EXPO_PUBLIC_API_BASE_URL=https://abfall-api.vercel.app
# Same value as ABFALL_APP_KEY in the Vercel project's env vars
EXPO_PUBLIC_API_KEY=

# Collection-centers map (Android needs this; iOS uses Apple Maps)
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Google Calendar sync (optional)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Calendar scanning runs on the server (abfall-api POST /v1/scan);
# its model key is set there, never here.
