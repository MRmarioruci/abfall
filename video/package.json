{
  "name": "abfall-video",
  "version": "1.0.0",
  "description": "Abfall product film, rendered from code with Remotion.",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/media": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render src/index.ts Film16x9 out/abfall-16x9.mp4",
    "render:vertical": "remotion render src/index.ts Film9x16 out/abfall-9x16.mp4",
    "render:de": "remotion render src/index.ts FilmDE16x9 out/abfall-de-16x9.mp4",
    "render:de:vertical": "remotion render src/index.ts FilmDE9x16 out/abfall-de-9x16.mp4",
    "render:all": "npm run render && npm run render:vertical && npm run render:de && npm run render:de:vertical",
    "music": "python3 scripts/make-music.py",
    "store": "sh scripts/store.sh"
  },
  "allowScripts": {
    "esbuild": false
  }
}
